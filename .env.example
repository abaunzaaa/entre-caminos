# =============================================================================
# Entre Caminos — copiar a .env y a backend/.env (sin subir a GitHub)
# =============================================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL oficial: Supabase (entre-caminos-db)
# DATABASE_URL = pooler transaction (6543) + pgbouncer=true
# DIRECT_URL   = pooler session (5432)
DATABASE_URL=
DIRECT_URL=

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12
COOKIE_SECURE=false

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=Entre Caminos <hola@entrecaminos.com>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAPBOX_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TEST_DATABASE_URL=
TEST_DIRECT_URL=

# --- Frontend (Vite) — copiar también a frontend/.env ---
# /api usa el proxy de Vite. No pongas secretos aquí.
VITE_API_URL=/api
VITE_MAPBOX_TOKEN=
VITE_APP_NAME=Entre Caminos
