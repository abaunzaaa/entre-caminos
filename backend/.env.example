# PostgreSQL en Supabase (proyecto entre-caminos-db)
# DATABASE_URL = Shared Pooler, transaction mode, puerto 6543
# DIRECT_URL   = Shared Pooler, session mode, puerto 5432
# Pega las URIs reales solo en backend/.env (nunca en GitHub).
DATABASE_URL=
DIRECT_URL=

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Solo seed local. Si la contraseña lleva #, ponla entre comillas:
# SEED_ADMIN_PASSWORD="TuClave#2026"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=Entre Caminos <hola@entrecaminos.com>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAPBOX_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opcional: proyecto Supabase de prueba (nunca la base compartida).
TEST_DATABASE_URL=
TEST_DIRECT_URL=
