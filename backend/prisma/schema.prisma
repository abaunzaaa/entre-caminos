generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CategoryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExperienceStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum DurationUnit {
  MINUTES
  HOURS
  DAYS
}

enum ExperienceReviewDecision {
  APPROVED
  REJECTED
}

enum ContactStatus {
  NEW
  READ
  CLOSED
}

enum ContactType {
  POSIBLE_USUARIO
  ALIADO
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                      String     @id @default(uuid())
  name                    String
  email                   String     @unique
  passwordHash            String     @map("password_hash")
  roleId                  String     @map("role_id")
  emailVerified           Boolean    @default(false) @map("email_verified")
  verificationCode        String?    @map("verification_code")
  verificationCodeExpires DateTime?  @map("verification_code_expires")
  status                  UserStatus @default(ACTIVE)
  phone                   String?
  country                 String?
  department              String?
  city                    String?
  address                 String?
  avatarUrl               String?    @map("avatar_url")
  mustChangePassword      Boolean    @default(false) @map("must_change_password")
  deletedAt               DateTime?  @map("deleted_at")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  role                     Role                      @relation(fields: [roleId], references: [id])
  experiences              Experience[]
  reviewedExperiences      Experience[]              @relation("ExperienceReviewedBy")
  reviewedCategories       Category[]                @relation("CategoryReviewedBy")
  experienceReviews        ExperienceReview[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  oauthAccounts            OAuthAccount[]
  profile                  UserProfile?
  conversations            Conversation[]
  folders                  Folder[]
  experienceFavorites      ExperienceFavorite[]
  experienceVisitorReviews ExperienceVisitorReview[]

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model Category {
  id              String         @id @default(uuid())
  name            String         @unique
  description     String?
  icon            String         @default("tags")
  status          CategoryStatus @default(PENDING)
  rejectionReason String?        @map("rejection_reason")
  reviewedAt      DateTime?      @map("reviewed_at")
  reviewedById    String?        @map("reviewed_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  experiences     Experience[]
  experienceLinks ExperienceCategory[]
  reviewedBy      User?                @relation("CategoryReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([reviewedById])
  @@map("categories")
}

model Experience {
  id              String           @id @default(uuid())
  title           String
  description     String
  categoryId      String           @map("category_id")
  price           Decimal          @db.Decimal(12, 2)
  currency        String           @default("COP") @db.VarChar(3)
  location        String
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  externalUrl     String?          @map("external_url")
  duration        String?
  durationValue   Int?             @map("duration_value")
  durationUnit    DurationUnit?    @map("duration_unit")
  availability    Json?
  howToGetThere   String?          @map("how_to_get_there")
  imageUrl        String?          @map("image_url")
  imageUrls       String[]         @default([]) @map("image_urls")
  status          ExperienceStatus @default(PENDING)
  createdBy       String           @map("created_by")
  submittedAt     DateTime?        @map("submitted_at")
  rejectionReason String?          @map("rejection_reason")
  reviewedAt      DateTime?        @map("reviewed_at")
  reviewedById    String?          @map("reviewed_by")
  isFeatured      Boolean          @default(false) @map("is_featured")
  featuredOrder   Int?             @map("featured_order")
  featuredFrom    DateTime?        @map("featured_from")
  featuredUntil   DateTime?        @map("featured_until")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  /// Compatibilidad. Siempre es la primera categoría (experienceCategories.position = 1).
  /// La fuente principal de categorías es experienceCategories.
  category                 Category                  @relation(fields: [categoryId], references: [id])
  experienceCategories     ExperienceCategory[]
  creator                  User                      @relation(fields: [createdBy], references: [id])
  reviewedBy               User?                     @relation("ExperienceReviewedBy", fields: [reviewedById], references: [id])
  reviews                  ExperienceReview[]
  conversations            Conversation[]
  experienceDetailViews    ExperienceDetailView[]
  experienceFavorites      ExperienceFavorite[]
  experienceVisitorReviews ExperienceVisitorReview[]

  @@index([status])
  @@index([categoryId])
  @@index([createdBy])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([isFeatured, featuredOrder])
  @@map("experiences")
}

/// Categorías de una experiencia, en el orden en que se registraron. Máximo 3.
model ExperienceCategory {
  experienceId String   @map("experience_id")
  categoryId   String   @map("category_id")
  position     Int
  createdAt    DateTime @default(now()) @map("created_at")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([experienceId, categoryId])
  @@unique([experienceId, position])
  @@index([categoryId])
  @@map("experience_categories")
}

model ExperienceReview {
  id           String                   @id @default(uuid())
  experienceId String                   @map("experience_id")
  reviewerId   String                   @map("reviewer_id")
  decision     ExperienceReviewDecision
  reason       String?
  createdAt    DateTime                 @default(now()) @map("created_at")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  @@index([experienceId, createdAt])
  @@index([reviewerId])
  @@map("experience_reviews")
}

model ExperienceDetailView {
  id           String   @id @default(uuid())
  experienceId String   @map("experience_id")
  createdAt    DateTime @default(now()) @map("created_at")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, createdAt])
  @@map("experience_detail_views")
}

model ExperienceFavorite {
  id           String   @id @default(uuid())
  experienceId String   @map("experience_id")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experienceId, userId])
  @@index([experienceId])
  @@map("experience_favorites")
}

model ExperienceVisitorReview {
  id           String   @id @default(uuid())
  experienceId String   @map("experience_id")
  userId       String   @map("user_id")
  rating       Int
  createdAt    DateTime @default(now()) @map("created_at")

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experienceId, userId])
  @@index([experienceId, createdAt])
  @@map("experience_visitor_reviews")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  link      String?
  entity    String?
  entityId  String?   @map("entity_id")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([userId, action])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

enum ProfileImageType {
  PHOTO
  AVATAR
}

enum AuthProvider {
  GOOGLE
  APPLE
  MICROSOFT
}

model UserProfile {
  id                    String           @id @default(uuid())
  userId                String           @unique @map("user_id")
  country               String?
  department            String?
  city                  String?
  neighborhood          String?
  addressReference      String?          @map("address_reference")
  latitude              Decimal?         @db.Decimal(10, 7)
  longitude             Decimal?         @db.Decimal(10, 7)
  profileImageUrl       String?          @map("profile_image_url")
  profileImagePublicId  String?          @map("profile_image_public_id")
  profileImageType      ProfileImageType @default(AVATAR) @map("profile_image_type")
  avatarConfig          Json?            @map("avatar_config")
  interests             String[]         @default([])
  companions            String[]         @default([])
  places                String[]         @default([])
  music                 String[]         @default([])
  budget                String[]         @default([])
  climate               String[]         @default([])
  onboardingCompleted   Boolean          @default(false) @map("onboarding_completed")
  onboardingCompletedAt DateTime?        @map("onboarding_completed_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onboardingCompleted])
  @@map("user_profiles")
}

model OAuthAccount {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Folder {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  icon      String?  @default("folder")
  createdAt DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([userId, createdAt])
  @@map("folders")
}

model Conversation {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  title          String   @default("Nueva conversación")
  contextType    String   @default("general") @map("context_type")
  experienceId   String?  @map("experience_id")
  experienceName String?  @map("experience_name")
  experienceData Json?    @map("experience_data")
  favorite       Boolean  @default(false)
  pinned         Boolean  @default(false)
  folderId       String?  @map("folder_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience Experience?           @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  folder     Folder?               @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages   ConversationMessage[]

  @@index([userId, updatedAt])
  @@index([userId, favorite])
  @@index([userId, pinned])
  @@index([experienceId])
  @@index([folderId])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Contact {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  type      ContactType
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@index([type])
  @@map("contacts")
}
